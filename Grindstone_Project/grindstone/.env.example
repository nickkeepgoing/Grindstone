OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
# ANTHROPIC_API_KEY only needed if JUDGE_MODEL uses anthropic/ directly (not via openrouter/)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Models
ATTACKER_MODEL=openrouter/qwen/qwen-2.5-72b-instruct
TARGET_MODEL=openrouter/openai/gpt-4o-mini
# Judge — pick any model that returns reliable JSON. Examples (only needs OPENROUTER_API_KEY):
JUDGE_MODEL=openrouter/openai/gpt-4o-mini
# JUDGE_MODEL=openrouter/anthropic/claude-sonnet-4.5
# JUDGE_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free
# Judge via Anthropic directly (needs ANTHROPIC_API_KEY):
# JUDGE_MODEL=anthropic/claude-sonnet-4-6
# Max tokens for the judge's JSON verdict (Claude needs headroom for reasoning):
JUDGE_MAX_TOKENS=1024

# Embedding (layer 2)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Server
HOST=0.0.0.0
PORT=8000

# Safety
SIMILARITY_THRESHOLD=0.65
MAX_TOKENS_PER_CALL=800
